# Copy to `.env` (git-ignored). `tfmxai` loads it on import, before tabpfn, tabicl and
# openml read their settings. Existing environment variables take precedence.

# Cache locations for model weights, Hugging Face downloads and OpenML datasets.
TABPFN_MODEL_CACHE_DIR=.cache/tabpfn
HF_HOME=.cache/hf
OPENML_CACHE_DIR=.cache/openml

TABPFN_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
